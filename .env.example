# ==============================================================================
# IntellMeet AI — Frontend Environment Variables Template
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# In Vite applications, all variables prefixed with VITE_ are bundled into the
# client-side JavaScript and are publicly readable in the browser!
# NEVER put private server secrets (e.g. JWT secret, DB password, OpenAI API secret key)
# in frontend .env files. Only public client identifiers and endpoints belong here.
# ==============================================================================

# ---- Application Info ----
VITE_APP_NAME="IntellMeet AI"
VITE_APP_ENV="development"
VITE_APP_VERSION="1.0.0"

# ---- Backend API & Real-time Services (Set to your actual backend domain) ----
BACKEND_URL="https://api.yourcompany.com"
VITE_BACKEND_URL="https://api.yourcompany.com"
VITE_SOCKET_URL="https://api.yourcompany.com"
VITE_API_BASE_URL="https://api.yourcompany.com/api/v1"
VITE_REMOTE_API_BASE_URL="https://api.yourcompany.com/api/v1"
VITE_WS_URL="wss://api.yourcompany.com"
VITE_API_TIMEOUT_MS="15000"

# ---- Single Sign-On (SSO) Client Credentials ----
# Google Workspace OAuth 2.0 Client ID (from Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
# Type: Web application
# Local Authorized JavaScript Origins: http://localhost:5173, http://localhost:5000
# Local Authorized Redirect URIs: http://localhost:5000/api/v1/auth/google/callback
# Production Authorized JavaScript Origins: https://app.yourcompany.com, https://api.yourcompany.com
# Production Authorized Redirect URIs: https://api.yourcompany.com/api/v1/auth/google/callback
# ⚠️ NEVER expose GOOGLE_CLIENT_SECRET in Vite frontend variables! Client secrets belong strictly in the backend .env.
VITE_GOOGLE_CLIENT_ID="your_google_client_id_here"
# Optional: Set only if using frontend-direct callback flow instead of backend-managed OAuth
# VITE_GOOGLE_CALLBACK_URL="http://localhost:5173/auth/google/callback"

# Microsoft Azure AD / Entra ID Client ID (from Azure Portal)
VITE_MICROSOFT_CLIENT_ID=""

# Enterprise SAML 2.0 Identity Provider Entity ID
VITE_SAML_ENTITY_ID=""

# ---- Feature Flags ----
# Enable mock authentication simulation when backend is not connected
VITE_ENABLE_MOCK_AUTH="true"

# Enable real-time AI transcription showcase
VITE_ENABLE_AI_TRANSCRIPTION="true"

# Enable or disable real-time Socket.IO polling (set to false for pure on-demand REST API)
VITE_ENABLE_SOCKET_POLLING="true"

# ---- Support & Legal Contacts ----
VITE_SUPPORT_EMAIL="support@intellmeet-ai.internal"
VITE_LEGAL_EMAIL="legal@intellmeet-ai.internal"
VITE_PRIVACY_EMAIL="privacy@intellmeet-ai.internal"
